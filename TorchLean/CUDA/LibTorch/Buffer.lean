module

public import TorchLean.CUDA.LibTorch.Controls
public import TorchLean.CUDA.LibTorch.Trusted
public import TorchLean.CUDA.Kernel.Emit.Binary

/-!
# CUDA Buffers

Low-level dtype-preserving operations on `Buffer`, the device handle of the LibTorch CUDA runtime.
TorchLean keeps its tape and selected local VJPs, and native calls record no LibTorch autograd
graph. `RuntimeStatus.query` reports which implementation is linked, `Memory.read` reads the
ownership and allocator counters, and `releaseIO` or `releaseThen` retires a buffer. Arithmetic on
configured binary formats runs kernels generated by `CUDA.emitBinary`. Each `@[extern]` declaration
is trusted native code. CUDA builds implement these operations in `csrc/libtorch/torchlean.cpp`.
Builds without LibTorch link `csrc/libtorch/unavailable.c`, which reports `.notLinked` and fails
every buffer operation.
-/

@[expose] public section

namespace TorchLean
namespace LibTorch

namespace Buffer

/-- Scalar representation retained by a live native buffer. Released handles must not be read. -/
@[never_extract, extern "torchlean_cuda_buffer_dtype"]
opaque dtype (b : @& Buffer) : Dtype

/-- Complete binary format of an encoded buffer, or `none` for a native buffer. -/
@[never_extract, extern "torchlean_cuda_buffer_format"]
opaque format? (b : @& Buffer) : Option FloatLib.Floats.Formats.BinaryInterchange.FloatFormat

/-- Upload complete configured words without converting through a native floating-point type. -/
@[never_extract, extern "torchlean_cuda_buffer_of_encoded_io"]
opaque ofEncodedIO (bytes : @& ByteArray)
    (format : @& FloatLib.Floats.Formats.BinaryInterchange.FloatFormat) (width : UInt64) : IO Buffer

/-- Download complete configured words, retaining signed zero and exceptional-value encodings. -/
@[never_extract, extern "torchlean_cuda_buffer_to_encoded_io"]
opaque toEncodedIO (buffer : @& Buffer) : IO ByteArray

@[never_extract, extern "torchlean_kernel_run_encoded"]
private opaque runEncoded (source : @& String) (inputs : @& Array Buffer)
    (format : @& FloatLib.Floats.Formats.BinaryInterchange.FloatFormat)
    (width count : UInt64) : Buffer

@[never_extract, extern "torchlean_cuda_buffer_fail"]
private opaque fail (message : @& String) : Buffer

/-! ### Runtime Availability -/

/-- What implementation sits behind the CUDA FFI symbols in the current process. -/
inductive RuntimeStatus where
  /-- The default build does not link LibTorch, so buffer operations fail. -/
  | notLinked
  /-- LibTorch CUDA is linked and at least one CUDA device is visible. -/
  | nativeAvailable
  /-- LibTorch CUDA is linked, but no usable CUDA device is visible. -/
  | nativeUnavailable
  deriving DecidableEq, Repr

/-- Raw status word from the C layer, decoded by `RuntimeStatus.query`. -/
@[never_extract, extern "torchlean_cuda_runtime_status"]
private opaque runtimeStatusRaw : IO UInt32

/-- Query whether LibTorch is linked and can see a CUDA device. -/
@[no_expose] def RuntimeStatus.query : IO RuntimeStatus := do
  match (← runtimeStatusRaw) with
  | 0 => pure .notLinked
  | 1 => pure .nativeAvailable
  | _ => pure .nativeUnavailable

/-- Require real CUDA execution for a user-selected CUDA session. -/
def requireNativeRuntime : IO Unit := do
  match (← RuntimeStatus.query) with
  | .nativeAvailable => pure ()
  | .notLinked =>
      throw <| IO.userError
        "CUDA was requested, but this executable was built without LibTorch; \
          rebuild and run with `-K cuda=true`"
  | .nativeUnavailable =>
      throw <| IO.userError
        "CUDA was requested and this is a CUDA build, but no usable CUDA device is visible"

/-! ### Allocator Telemetry -/

/-- Logical payload bytes owned by TorchLean buffer handles at the time of the read. -/
@[never_extract, extern "torchlean_cuda_allocator_live_bytes"]
private opaque allocatorLiveBytesRaw : IO UInt64

/-- High-water mark of `allocatorLiveBytesRaw` since process start. -/
@[never_extract, extern "torchlean_cuda_allocator_peak_bytes"]
private opaque allocatorPeakBytesRaw : IO UInt64

/-- Nonempty buffer payload owners created, independently of native allocator reuse. -/
@[never_extract, extern "torchlean_cuda_allocator_alloc_count"]
private opaque allocatorAllocCountRaw : IO UInt64

/-- Nonempty buffer payload owners retired, independently of native allocator reuse. -/
@[never_extract, extern "torchlean_cuda_allocator_free_count"]
private opaque allocatorFreeCountRaw : IO UInt64

/-- Live external buffer wrappers, including empty or already released wrappers. -/
@[never_extract, extern "torchlean_cuda_wrapper_live_count"]
private opaque wrapperLiveCountRaw : IO UInt64

/-- High-water mark of that live wrapper count. -/
@[never_extract, extern "torchlean_cuda_wrapper_peak_count"]
private opaque wrapperPeakCountRaw : IO UInt64

/-- Wrappers created since process start. -/
@[never_extract, extern "torchlean_cuda_wrapper_alloc_count"]
private opaque wrapperAllocCountRaw : IO UInt64

/-- Wrappers finalized by the Lean garbage collector since process start. -/
@[never_extract, extern "torchlean_cuda_wrapper_finalize_count"]
private opaque wrapperFinalizeCountRaw : IO UInt64

/-- Free bytes on the device as `cudaMemGetInfo` reports them, so the allocator's cache counts as
used. -/
@[never_extract, extern "torchlean_cuda_allocator_device_free_bytes"]
private opaque allocatorDeviceFreeBytesRaw : IO UInt64

/-- Total device memory reported by the driver. -/
@[never_extract, extern "torchlean_cuda_allocator_device_total_bytes"]
private opaque allocatorDeviceTotalBytesRaw : IO UInt64

/-- Selected-device bytes allocated by the LibTorch CUDA allocator at the time of the read. -/
@[never_extract, extern "torchlean_libtorch_allocated_bytes"]
private opaque allocatedBytesRaw : IO UInt64

/-- Selected-device bytes reserved by the LibTorch CUDA allocator at the time of the read. -/
@[never_extract, extern "torchlean_libtorch_reserved_bytes"]
private opaque reservedBytesRaw : IO UInt64

/-- Peak selected-device allocation since the native allocator's last peak reset. -/
@[never_extract, extern "torchlean_libtorch_peak_allocated_bytes"]
private opaque peakAllocatedBytesRaw : IO UInt64

/-- Peak selected-device reservation since the native allocator's last peak reset. -/
@[never_extract, extern "torchlean_libtorch_peak_reserved_bytes"]
private opaque peakReservedBytesRaw : IO UInt64

/--
Snapshot of TorchLean ownership counters and the LibTorch CUDA allocator.

`liveBytes`/`peakBytes` count logical device payloads owned by TorchLean handles. They differ from
physical VRAM usage: shared tensor storage may be counted more than once, and native temporaries
or saved attention state need not have a separate TorchLean handle. `allocCount` and `freeCount`
count the creation and release of those payloads, which need not match native allocation calls.

The wrapper counters track Lean external buffer objects, including empty and already released
wrappers. All these ownership counters are process-wide. They help distinguish retained Lean
owners from storage managed internally by LibTorch.

`allocatedBytes`, `reservedBytes`, `peakAllocatedBytes`, and `peakReservedBytes` are the native
allocator's counters for the selected CUDA device. Reserved bytes include storage the allocator
retains for reuse. `deviceFreeBytes` and `deviceTotalBytes` report driver memory for that device.
These six device counters are zero when LibTorch is not linked. Native allocator peaks follow its
own reset lifecycle.

LibTorch's caching policy decides when retained storage is released, and
`LibTorch.setMemoryFraction` sets its allocation limit for the selected device.

The fields are read one at a time, so a snapshot can mix in concurrent allocator activity from
elsewhere in the process.
-/
structure Memory where
  /-- Logical payload bytes owned by TorchLean buffer handles. -/
  liveBytes : UInt64
  /-- The largest `liveBytes` since process start. -/
  peakBytes : UInt64
  /-- Nonempty buffer payloads created since process start. -/
  allocCount : UInt64
  /-- Nonempty buffer payloads released since process start. -/
  freeCount : UInt64
  /-- Live external buffer wrappers, empty and released ones included. -/
  wrapperLiveCount : UInt64
  /-- The largest `wrapperLiveCount` since process start. -/
  wrapperPeakCount : UInt64
  /-- External buffer wrappers created since process start. -/
  wrapperAllocCount : UInt64
  /-- External buffer wrappers finalized by the Lean garbage collector since process start. -/
  wrapperFinalizeCount : UInt64
  /-- Free device bytes as `cudaMemGetInfo` reports them, with the allocator's cache counted as
  used. -/
  deviceFreeBytes : UInt64
  /-- Total device memory that the driver reports. -/
  deviceTotalBytes : UInt64
  /-- Bytes that the LibTorch CUDA allocator has allocated on the selected device. -/
  allocatedBytes : UInt64
  /-- Bytes that the LibTorch CUDA allocator reserves on the selected device, its cache included. -/
  reservedBytes : UInt64
  /-- The largest `allocatedBytes` since the native allocator's last peak reset. -/
  peakAllocatedBytes : UInt64
  /-- The largest `reservedBytes` since the native allocator's last peak reset. -/
  peakReservedBytes : UInt64
deriving Repr

/-- Read the ownership and allocator counters of `Memory`, one native read per field each time
the action runs. -/
@[no_expose] def Memory.read : IO Memory := do
  pure
    { liveBytes := (← allocatorLiveBytesRaw)
      peakBytes := (← allocatorPeakBytesRaw)
      allocCount := (← allocatorAllocCountRaw)
      freeCount := (← allocatorFreeCountRaw)
      wrapperLiveCount := (← wrapperLiveCountRaw)
      wrapperPeakCount := (← wrapperPeakCountRaw)
      wrapperAllocCount := (← wrapperAllocCountRaw)
      wrapperFinalizeCount := (← wrapperFinalizeCountRaw)
      deviceFreeBytes := (← allocatorDeviceFreeBytesRaw)
      deviceTotalBytes := (← allocatorDeviceTotalBytesRaw)
      allocatedBytes := (← allocatedBytesRaw)
      reservedBytes := (← reservedBytesRaw)
      peakAllocatedBytes := (← peakAllocatedBytesRaw)
      peakReservedBytes := (← peakReservedBytesRaw) }

/-- Format a byte count as MiB for allocator progress messages. -/
@[no_expose] private def mibString (bytes : UInt64) : String :=
  let mib := (Float.ofNat bytes.toNat) / (1024.0 * 1024.0)
  toString mib ++ " MiB"

/-- One-line allocator report distinguishing logical payloads from native storage. -/
@[no_expose] def Memory.format (s : Memory) : String :=
  "payload=" ++ mibString s.liveBytes ++
  " payload_peak=" ++ mibString s.peakBytes ++
  " allocs=" ++ toString s.allocCount ++
  " frees=" ++ toString s.freeCount ++
  " wrappers_live=" ++ toString s.wrapperLiveCount ++
  " wrappers_peak=" ++ toString s.wrapperPeakCount ++
  " wrappers_alloc=" ++ toString s.wrapperAllocCount ++
  " wrappers_finalized=" ++ toString s.wrapperFinalizeCount ++
  " cuda_free=" ++ mibString s.deviceFreeBytes ++
  " cuda_total=" ++ mibString s.deviceTotalBytes ++
  " allocated=" ++ mibString s.allocatedBytes ++
  " reserved=" ++ mibString s.reservedBytes ++
  " peak_allocated=" ++ mibString s.peakAllocatedBytes ++
  " peak_reserved=" ++ mibString s.peakReservedBytes

/--
Create a device buffer by copying from a host `FloatArray` in the requested dtype.

This primitive has a pure Lean type, but the native implementation allocates a fresh device buffer.
Runtime code should use `ofFloatArrayIO`: each call allocates a distinct buffer, and ordinary device
exhaustion is returned as an IO error that the caller can handle.
-/
@[never_extract, extern "torchlean_cuda_buffer_of_float_array"]
opaque ofFloatArray (a : @& FloatArray) (dtype : Dtype := .float32) : Buffer

/--
Copy a host `FloatArray` into a fresh device buffer in the requested dtype.

The upload runs at this point in the IO sequence. Repeated calls with the same host array allocate
distinct buffers, so releasing one does not invalidate another. Native allocation failures return
`IO.Error.resourceExhausted`. LibTorch owns the device allocator's retry policy. The host array and
existing device buffers remain owned by the caller.
-/
@[never_extract, extern "torchlean_cuda_buffer_of_float_array_io"]
opaque ofFloatArrayIO (a : @& FloatArray) (dtype : Dtype := .float32) : IO Buffer

/-- Copy a buffer back to a host `FloatArray`, widening binary32 when needed. -/
@[never_extract, extern "torchlean_cuda_buffer_to_float_array"]
opaque toFloatArray (b : @& Buffer) : FloatArray

/-- Download a buffer to the host, widening each element to Lean `Float`. -/
@[never_extract, extern "torchlean_cuda_buffer_to_float_array_io"]
opaque toFloatArrayIO (b : @& Buffer) : IO FloatArray

/--
Copy a buffer to little-endian scalar words, in its own dtype by default and converted to an
explicit different `dtype` otherwise.

The CUDA Adam optimizer checkpoint writes its moment buffers this way. Unlike `toFloatArrayIO`, it
does not widen every element to Lean `Float`, so a large CUDA buffer can be written without
constructing a second double-precision host array for binary32 data.
-/
@[never_extract, extern "torchlean_cuda_buffer_to_bytes_io"]
opaque toBytesIO (b : @& Buffer) (dtype : Dtype := Buffer.dtype b) : IO ByteArray

/--
Upload little-endian scalar words to a fresh device buffer.

`source` describes the payload and `dtype` selects storage. They agree by default, and a different
`source` is an explicit conversion. Native allocation failures return
`IO.Error.resourceExhausted` before a buffer is returned. The borrowed byte payload remains
available to the caller.
-/
@[never_extract, extern "torchlean_cuda_buffer_of_bytes_io"]
opaque ofBytesIO (bytes : @& ByteArray) (dtype : Dtype := .float32)
    (source : Dtype := dtype) : IO Buffer

/-- Number of scalar elements in the buffer, independently of dtype. -/
@[never_extract, extern "torchlean_cuda_buffer_size"]
opaque size (b : @& Buffer) : UInt32

/-- Evaluate a configured arithmetic expression on resident tape buffers. -/
private def encoded (reference : Buffer) (inputs : Array Buffer)
    (expr : Kernel.Expr Nat [.index] .scalar) : Buffer :=
  match format? reference with
  | none => fail "autograd: configured arithmetic requires a binary format"
  | some format =>
    if inputs.all (fun input => format? input == some format && size input == size reference) then
      match CUDA.emitBinary format id inputs.size expr with
      | .error message => fail message
      | .ok source => runEncoded source inputs format
          ((Kernel.Precision.binary format).bytes.toUInt64) (size reference).toUInt64
    else fail "autograd: configured arithmetic operands have different formats or sizes"

/-- Read the element count of `b` at this point of the `IO` sequence. A buffer released earlier
in the sequence reads as zero. -/
@[never_extract, extern "torchlean_cuda_buffer_size_io"]
opaque sizeIO (b : @& Buffer) : IO UInt32

/-- Release the device payload of `b` at this point of the `IO` sequence, returning `1` when it
frees a nonempty payload and `0` otherwise. `Buffer` values are copyable references to one
native allocation, so the release invalidates every alias, and no alias may be used after it. -/
@[never_extract, extern "torchlean_cuda_buffer_release_io"]
opaque releaseIO (b : @& Buffer) : IO UInt32

/--
Release `workspace` and return `keep`, such as a buffer computed from the workspace or the gradient
array the autograd tape continues with after retiring a contribution no node keeps. As with
`releaseIO`, the release invalidates every alias of `workspace`, so `keep` must neither be such an
alias nor hold one.

This exists for pure CUDA tape code: because the returned value is used downstream, Lean cannot
erase the native release call as dead code.
-/
@[never_extract, extern "torchlean_cuda_buffer_release_then"]
def releaseThen {β : Type} (_workspace : @& Buffer) (keep : @& β) : β := keep

/--
Release a collection of workspace buffers and return `keep`.

Many CUDA tape formulas create a group of intermediate buffers, then continue with one final result
buffer. Threading cleanup through the result keeps ownership local to the formula and avoids waiting
for external-object finalizers in long training loops.
-/
def releaseManyThen (workspace : Array Buffer) (keep : @& Buffer) : Buffer :=
  workspace.foldr (fun b acc => releaseThen b acc) keep

/--
A CUDA result together with the workspace buffers used to compute it.

This is the common ownership shape for eager CUDA formulas. Some forward computations need
intermediate buffers again during the backward pass, so the tape keeps those buffers on the node
and releases them when the node is retired. Backward formulas use the same shape when they
recompute a value only to differentiate through it.
-/
structure WithWorkspace where
  /-- The CUDA result. -/
  value : Buffer
  /-- The workspace buffers used to compute `value`. -/
  workspace : Array Buffer := #[]

namespace WithWorkspace

/-- Return `keep` after releasing all workspace buffers owned by this result. -/
def releaseWorkspaceThen (r : WithWorkspace) (keep : @& Buffer) : Buffer :=
  releaseManyThen r.workspace keep

/-- Return `keep` after releasing both the result buffer and its workspace buffers. -/
def releaseAllThen (r : WithWorkspace) (keep : @& Buffer) : Buffer :=
  releaseThen r.value <| releaseManyThen r.workspace keep

end WithWorkspace

/-- Ask the host allocator to collect freed pages, leaving LibTorch's device cache and every live
buffer untouched. Training and evaluation call this after retiring a completed tape. -/
@[never_extract, extern "torchlean_runtime_collect_allocator"]
opaque collectGarbage : IO Unit

/-- Allocate a length-`n` buffer filled with zeros. -/
@[never_extract, extern "torchlean_cuda_buffer_zeros"]
opaque zeros (n : UInt32) (dtype : Dtype := .float32) : Buffer

/-- Allocate zeros in the reference buffer's complete scalar format. -/
@[never_extract, extern "torchlean_cuda_buffer_zeros_like"]
opaque zerosLike (reference : @& Buffer) (count : UInt32 := size reference) : Buffer

/--
Allocate a fresh zero-filled buffer inside `IO` code.

The allocation runs at this point in the IO sequence. Native allocation failures return
`IO.Error.resourceExhausted`, so a caller can release its temporary buffers and try a smaller
allocation. LibTorch owns the device allocator's retry policy. Existing live buffers remain owned
by their callers, and a failed allocation adds no live buffer to the counters.

The allocating IO constructors share this error boundary. Pure allocation and kernel primitives
have their own native failure policy.
-/
@[never_extract, extern "torchlean_cuda_buffer_zeros_io"]
opaque zerosIO (n : UInt32) (dtype : Dtype := .float32) : IO Buffer

/-- Allocate a length-`n` buffer filled with `v`, rounded in the requested dtype. -/
@[never_extract, extern "torchlean_cuda_buffer_full"]
opaque full (n : UInt32) (v : Float) (dtype : Dtype := .float32) : Buffer

/--
Allocate a fresh length-`n` buffer filled with `v`, rounded in the requested dtype.

Each call owns a distinct buffer. Native allocation failures return `IO.Error.resourceExhausted`,
as in `zerosIO`.
-/
@[never_extract, extern "torchlean_cuda_buffer_full_io"]
opaque fullIO (n : UInt32) (v : Float) (dtype : Dtype := .float32) : IO Buffer

/-!
### Deterministic RNG (device-side)

These are low-level building blocks used by TorchLean's seeded RNG ops (`rand_uniform`,
`bernoulli_mask`) when running on the eager CUDA backend.

They use the same SplitMix64-style mixing as `Random` so results are deterministic given the key
`Random.keyOf seed counter` and a row-major linear index.
-/

/-- Allocate `n` deterministic draws `d / 2^32` keyed by `key`, each `d` a 32-bit word, rounded into
`dtype`, so a float32 draw can round up to `1`. Allocation failures return
`IO.Error.resourceExhausted`, as in `zerosIO`. -/
@[never_extract, extern "torchlean_cuda_buffer_rand_uniform_io"]
opaque randUniformIO (n : UInt32) (key : UInt64) (dtype : Dtype := .float32) : IO Buffer

/-- Allocate a length-`n` mask keyed by `key` whose entry `i` is `1` when `keepProb`, rounded into
`dtype`, is at least `1` or exceeds the `i`-th draw of `randUniformIO`, and `0` otherwise.
Allocation failures return `IO.Error.resourceExhausted`, as in `zerosIO`. -/
@[never_extract, extern "torchlean_cuda_buffer_bernoulli_mask_io"]
opaque bernoulliMaskIO (n : UInt32) (keepProb : Float) (key : UInt64)
    (dtype : Dtype := .float32) : IO Buffer

/-- Absolute value applied pointwise to a CUDA buffer. -/
@[never_extract, extern "torchlean_cuda_buffer_abs"]
opaque abs (b : @& Buffer) : Buffer

/-- Backward for `abs`: `dx = Context.sign x * dLdy`, where `Context.sign x` is `x` itself at a
zero or NaN. -/
@[never_extract, extern "torchlean_cuda_buffer_abs_bwd"]
opaque absBackward (x dLdy : @& Buffer) : Buffer

/-- Elementwise `sqrt (max x 0)`, matching `Tensor.sqrt x .clampNegative`.

Negative inputs and either signed zero return positive zero. NaN inputs remain NaN, and the clamp
uses the same ordered comparison as the floating-point maximum in the tensor spec. -/
@[never_extract, extern "torchlean_cuda_buffer_sqrt"]
opaque sqrtClampNegative (b : @& Buffer) : Buffer

/-- Backward for `sqrtClampNegative` by the rule of `Op.sqrt .clampNegative`
(`rule?_sqrt_clampNegative`): `dLdy / (2 r)` rounded once at the rounded root `r` where `x > 0`,
else `0 * dLdy`, which is `-0` at a negative `dLdy` and a NaN at a nonfinite one. -/
@[never_extract, extern "torchlean_cuda_buffer_sqrt_bwd"]
opaque sqrtClampNegativeBackward (x dLdy : @& Buffer) : Buffer

/-- Elementwise IEEE 754 square root (`at::sqrt`), matching `Tensor.sqrt x`: `-0` at `-0` and a NaN
below zero. -/
@[never_extract, extern "torchlean_cuda_buffer_sqrt_raw"]
opaque sqrt (b : @& Buffer) : Buffer

/-- Backward for `sqrt`: `dLdy / (2 |sqrt x|)`, one division, so `+inf * dLdy` at either zero and
a NaN below zero and at a NaN. -/
@[never_extract, extern "torchlean_cuda_buffer_sqrt_raw_bwd"]
opaque sqrtBackward (x dLdy : @& Buffer) : Buffer

/-- Elementwise `exp`. -/
@[never_extract, extern "torchlean_cuda_buffer_exp"]
opaque exp (b : @& Buffer) : Buffer

/--
Elementwise sine of angles in radians, retaining the input dtype.

The native implementation uses `at::sin`. The input is borrowed, so the tape can
retain it for the cosine factor in the backward pass.
-/
@[never_extract, extern "torchlean_cuda_buffer_sin"]
opaque sin (b : @& Buffer) : Buffer

/--
Elementwise cosine of angles in radians, retaining the input dtype and borrowing its input.
-/
@[never_extract, extern "torchlean_cuda_buffer_cos"]
opaque cos (b : @& Buffer) : Buffer

/-- Elementwise natural logarithm. -/
@[never_extract, extern "torchlean_cuda_buffer_log"]
opaque log (b : @& Buffer) : Buffer

/-- Elementwise `log(1 + x)` without losing a small positive `x` in the addition. -/
@[never_extract, extern "torchlean_cuda_buffer_log1p"]
opaque log1p (b : @& Buffer) : Buffer

/-- Elementwise `exp(x) - 1`, retaining small arguments near zero. -/
@[never_extract, extern "torchlean_cuda_buffer_expm1"]
opaque expm1 (b : @& Buffer) : Buffer

/-- Reciprocal: `1/x`. -/
@[never_extract, extern "torchlean_cuda_buffer_inv"]
opaque inv (b : @& Buffer) : Buffer

/-- Clamp each element to `[lo, hi]` (bounds are host `Float`s rounded to the dtype), as
`Context.clamp`: IEEE 754-2019 9.6 `minimum (maximum x lo) hi`. Its pullback `clampBackward` is
`clampDerivative x lo hi * g`, the coefficient one strictly inside `(lo, hi)` and zero elsewhere
times the cotangent. -/
@[never_extract, extern "torchlean_cuda_buffer_clamp"]
opaque clamp (b : @& Buffer) (lo hi : Float) : Buffer

/--
Backward for `clamp`: `clampDerivative x lo hi * g`, the coefficient `1` strictly inside `(lo, hi)`
and `0` elsewhere, multiplied by the cotangent `g` (so a zero coefficient gives `0 * g`: a NaN at an
infinite or NaN `g`, `-0` at a negative one).
-/
@[never_extract, extern "torchlean_cuda_buffer_clamp_bwd"]
opaque clampBackward (x dLdy : @& Buffer) (lo hi : Float) : Buffer

/-- Pointwise IEEE 754-2019 9.6 `maximum` of two equal-length CUDA buffers, `Context.maximum`: a
NaN where an operand is one, `+0` above `-0`. -/
@[never_extract, extern "torchlean_cuda_buffer_max"]
opaque max (a b : @& Buffer) : Buffer

/--
Backward for `max`, returning `(dA, dB)`, selected as the CPU rule: the strict winner receives the
cotangent bit for bit, the strict loser `+0` at every cotangent, and a tie or an unordered pair (a
NaN operand) half of the cotangent each.
-/
@[never_extract, extern "torchlean_cuda_buffer_max_bwd"]
opaque maxBackward (a b dLdy : @& Buffer) : Buffer × Buffer

/-- Elementwise IEEE 754-2019 9.6 `minimum` of two buffers, `Context.minimum`: a NaN where an
operand is one, `-0` below `+0`. -/
@[never_extract, extern "torchlean_cuda_buffer_min"]
opaque min (a b : @& Buffer) : Buffer

/--
Backward for `min`, returning `(dA, dB)`: the cotangent for the strict winner, `+0` for the strict
loser and half of the cotangent each at a tie or an unordered pair, as `maxBackward`.
-/
@[never_extract, extern "torchlean_cuda_buffer_min_bwd"]
opaque minBackward (a b dLdy : @& Buffer) : Buffer × Buffer

/-- Pointwise division of two equal-length CUDA buffers. -/
@[never_extract, extern "torchlean_cuda_buffer_div"]
private opaque divNative (a b : @& Buffer) : Buffer

/-- Pointwise quotient in the stored format, with exceptional values following that format. -/
@[no_expose] def div (a b : @& Buffer) : Buffer :=
  if (format? a).isSome then
    encoded a #[a, b] (.binary .div (.load 0 (.var .zero)) (.load 1 (.var .zero)))
  else divNative a b

/-- Direct pointwise negation, including the sign of zero. -/
@[never_extract, extern "torchlean_cuda_buffer_neg"]
private opaque negNative (x : @& Buffer) : Buffer

/-- Direct negation, including the format's signed-zero convention. -/
@[no_expose] def neg (x : @& Buffer) : Buffer :=
  if (format? x).isSome then encoded x #[x] (.neg (.load 0 (.var .zero)))
  else negNative x

/--
Keep values where the equal-length mask is nonzero and select zero elsewhere.

Unlike multiplication by the mask, selection discards nonfinite values in blocked entries.
A NaN mask is nonzero, matching the numerical backend's boolean conversion.
-/
@[never_extract, extern "torchlean_cuda_buffer_mask"]
opaque mask (values allowed : @& Buffer) : Buffer

/-- `Op.dropout` on a buffer, the same map in both passes: an entry is kept iff its entry of the
uniform sample `u` is at least `p`, a kept entry is `x / (1 - p)`, one IEEE division by a
device-tensor divisor, a dropped one is `x * 0`, and every entry is `+0` when `p ≥ 1`. `p` is
rounded to the dtype and `1 - p` is rounded once in it. -/
@[never_extract, extern "torchlean_cuda_buffer_dropout"]
opaque dropout (x u : @& Buffer) (p : Float) : Buffer

/-- Pointwise ReLU activation on a CUDA buffer. -/
@[never_extract, extern "torchlean_cuda_buffer_relu"]
opaque relu (b : @& Buffer) : Buffer

/-- Backward for `relu`: `reluDeriv x * dLdy`, which is `-0` at a negative `dLdy` and a NaN
at a nonfinite one where `x > 0` fails, at a NaN `x` too. -/
@[never_extract, extern "torchlean_cuda_buffer_relu_bwd"]
opaque reluBackward (x dLdy : @& Buffer) : Buffer

/--
Elementwise logistic sigmoid with branch-stable ATen arithmetic, retaining the input dtype.

The input is borrowed, and TorchLean's tape evaluates the slope from the input's decaying
exponential and never subtracts the rounded output from one. The native helper uses only
nonpositive exponential arguments. ATen's elementary operations and their rounding remain a native
boundary.
-/
@[never_extract, extern "torchlean_cuda_buffer_sigmoid"]
opaque sigmoid (x : @& Buffer) : Buffer

/-- Sigmoid's weighted pullback `z / (1 + z)^2 * seed` with `z = exp(-|x|)`. Where the slope or
the product falls below the least normal at finite `x` and `seed`, binary32 rounds once the
replay `q^2 seed / (1 + q^2)^2` of `Numeric.applySlope`, evaluated in binary64
at the device's `q = exp(-|x| / 2)` (the binary64 exp where that `q` is subnormal or zero) and
moved one binary64 unit toward zero where `x ≠ 0` and `-|x| / 2` rounds below the least normal
(there the rule encloses the exact slope), and binary64 squares `sqrt |seed| * q / (1 + z)`
rounded in stages, with the sign of `seed`. -/
@[never_extract, extern "torchlean_cuda_buffer_sigmoid_bwd"]
opaque sigmoidBackward (x seed : @& Buffer) : Buffer

/--
Elementwise hyperbolic tangent through `at::tanh`, retaining the input dtype.

Direct evaluation avoids cancellation near zero and preserves signed zero. The input is borrowed,
and TorchLean's tape evaluates its derivative from the input's scaled reciprocal cosh.
-/
@[never_extract, extern "torchlean_cuda_buffer_tanh"]
opaque tanh (x : @& Buffer) : Buffer

/-- Tanh's weighted pullback `((z + z) / (1 + z^2))^2 * seed` with `z = exp(-|x|)`. Where the
slope or the product falls below the least normal at finite `x` and `seed`, binary32 evaluates
the replay `4 q^4 seed / (1 + q^4)^2` of `Numeric.applySlope` in binary64 at
the device's `q = exp(-|x| / 2)` (the binary64 exp where that `q` is subnormal or zero) and
rounds it once, and binary64 squares `2 sqrt |seed| q^2 / (1 + z^2)` rounded in stages, with the
sign of `seed`. -/
@[never_extract, extern "torchlean_cuda_buffer_tanh_bwd"]
opaque tanhBackward (x seed : @& Buffer) : Buffer

/-- Tanh-approximate GELU in the order and with the constants of `TorchLean.Activation.geluTanh`,
composed from ATen operations with the device's `tanh`. -/
@[never_extract, extern "torchlean_cuda_buffer_gelu"]
opaque gelu (x : @& Buffer) : Buffer

/-- SiLU with a split exponential on the negative branch, retaining the input dtype. -/
@[never_extract, extern "torchlean_cuda_buffer_silu"]
opaque silu (x : @& Buffer) : Buffer

/-- SiLU VJP, evaluated from the input without reusing a rounded sigmoid output. -/
@[never_extract, extern "torchlean_cuda_buffer_silu_bwd"]
opaque siluBackward (x dLdy : @& Buffer) : Buffer

/-- The weighted GELU pullback `TorchLean.Activation.geluTanhDeriv x * dLdy`, evaluated in that
definition's order with the device `exp`. Where the squared reciprocal cosh of the inner argument
`u` is subnormal or zero the kernel keeps it, which `TorchLean.Numeric.tanhDeriv` replaces by
`4 q^4 / (1 + q^4)^2` at the rounded `q = exp (-|u| / 2)`, rounded once. -/
@[never_extract, extern "torchlean_cuda_buffer_gelu_bwd"]
opaque geluBackward (x dLdy : @& Buffer) : Buffer

/-- Elementwise addition (sizes must match). -/
@[never_extract, extern "torchlean_cuda_buffer_add"]
private opaque addNative (a b : @& Buffer) : Buffer

/-- Pointwise addition, retaining the complete configured format when present. -/
@[no_expose] def add (a b : @& Buffer) : Buffer :=
  if (format? a).isSome then
    encoded a #[a, b] (.binary .add (.load 0 (.var .zero)) (.load 1 (.var .zero)))
  else addNative a b

/-- Elementwise subtraction (sizes must match). -/
@[never_extract, extern "torchlean_cuda_buffer_sub"]
private opaque subNative (a b : @& Buffer) : Buffer

/-- Pointwise subtraction without implicit precision conversion. -/
@[no_expose] def sub (a b : @& Buffer) : Buffer :=
  if (format? a).isSome then
    encoded a #[a, b] (.binary .sub (.load 0 (.var .zero)) (.load 1 (.var .zero)))
  else subNative a b

/-- Elementwise multiplication (sizes must match). -/
@[never_extract, extern "torchlean_cuda_buffer_mul"]
private opaque mulNative (a b : @& Buffer) : Buffer

/-- Pointwise multiplication without implicit precision conversion. -/
@[no_expose] def mul (a b : @& Buffer) : Buffer :=
  if (format? a).isSome then
    encoded a #[a, b] (.binary .mul (.load 0 (.var .zero)) (.load 1 (.var .zero)))
  else mulNative a b

/--
Multiply each element by a scalar `c`, rounded in the buffer dtype.

This is a primitive building block for many ops (e.g. scaling gradients).
-/
@[never_extract, extern "torchlean_cuda_buffer_scale"]
opaque scale (b : @& Buffer) (c : Float) : Buffer

/-- Device-to-device copy without arithmetic or precision conversion. -/
@[never_extract, extern "torchlean_cuda_buffer_copy"]
opaque copy (b : @& Buffer) : Buffer

/-- Two independently owned copies. Separate identical pure calls can be shared by Lean's
compiler, which is unsafe when one VJP contribution is retired before the other is consumed. -/
@[never_extract, extern "torchlean_cuda_buffer_duplicate"]
opaque duplicate (b : @& Buffer) : Buffer × Buffer

/--
Copy a buffer and release the source after the copy has been produced.

The native operation creates the destination before it retires the source, so the compiler cannot
reorder the two lifetime events. Use this at ownership-transfer boundaries in the sparse CUDA tape.
-/
@[never_extract, extern "torchlean_cuda_buffer_copy_and_release"]
private opaque copyAndReleaseNative (b : @& Buffer) : Buffer

/-- Copy before retiring the source, preserving its scalar format. -/
@[no_expose] def copyAndRelease (b : @& Buffer) : Buffer :=
  if (format? b).isSome then releaseThen b (copy b)
  else copyAndReleaseNative b

/--
Fused multiply-add `a + c * b`, where `a` and `b` have equal sizes and dtypes and `c` is rounded
in that dtype.

This is the BLAS-style `axpy` primitive and is useful for optimizers and bias-like updates.
-/
@[never_extract, extern "torchlean_cuda_buffer_axpy"]
opaque axpy (a b : @& Buffer) (c : Float) : Buffer

/--
Perform one Adam-family update through LibTorch tensor operations.

The result is `(parameters, firstMoment, secondMoment)`. Adam passes `decay = none`, which skips
the decay step. AdamW passes `some (-(lr * weightDecay))` and adds that multiple of each
parameter, so even a zero coefficient turns an infinite parameter into a NaN, as `AdamW.update`
does. The caller supplies the two denominators `1 - beta^t`, with `beta^t` from the recurrence of
`npowRec` rounded in the parameter dtype. The native bridge computes reciprocals in host `Float`
and rounds them in the parameter dtype. If a reciprocal does not fit, it divides the moment
directly, and the corrected RMS also avoids an unnecessary squared overflow. Exceptional weighted
quotients use power-of-two rescaling, including the parameter addition, while ordinary entries
keep the fused update. This schedule differs from the CPU's exact-coefficient replay and need not
match every scalar-polymorphic instantiation bit for bit.

The caller must validate that `epsilon` remains finite and positive in the parameter dtype.
The native eager optimizer and its checkpoint reader share that validation.

TorchLean's optimizer definitions specify the update. The native bridge evaluates the pointwise
expressions and returns the updated parameter and moment buffers.
-/
@[never_extract, extern "torchlean_cuda_buffer_adam_step"]
opaque adamStep
    (parameters gradient firstMoment secondMoment : @& Buffer)
    (beta1 oneMinusBeta1 beta2 oneMinusBeta2 : Float)
    (firstMomentDenominator secondMomentDenominator epsilon : Float)
    (decay : @& Option Float) (updateScale : Float) :
    Buffer × Buffer × Buffer

/--
Scaled product exponential: `exp((c * x) * y)`.

LibTorch evaluates the two multiplications followed by the exponential. `x` and `y` have equal
lengths and dtypes, and `c` is a host `Float` rounded in that dtype.
-/
@[never_extract, extern "torchlean_cuda_buffer_scaled_prod_exp"]
opaque scaledProdExp (x y : @& Buffer) (c : Float) : Buffer

/-- Reductions (return a length-1 buffer). -/
@[never_extract, extern "torchlean_cuda_buffer_reduce_sum"]
opaque reduceSum (b : @& Buffer) : Buffer

/-- Mean of all elements, returned as a one-element buffer: the sum divided once by the element
count (`divCount`), by one for an empty buffer, whose sum is zero (`Op.mean`'s empty fiber). -/
@[never_extract, extern "torchlean_cuda_buffer_reduce_mean"]
opaque reduceMean (b : @& Buffer) : Buffer

/-- Each element divided once by the count `n` (`Context.divNat`): the exact quotient rounded once
to the dtype, through a device-tensor divisor (count zero: the IEEE division by zero). binary32
divides in binary64 and then rounds to binary32, the same value for `n < 2 ^ 29`. The native
boundary rejects binary32 counts from `2 ^ 29` and binary64 counts from `2 ^ 53`. -/
@[never_extract, extern "torchlean_cuda_buffer_div_count"]
opaque divCount (b : @& Buffer) (n : UInt64) : Buffer

/-- `Tensor.meanSquaredError` of the differences `d`, as a one-element buffer: the sum of the
squares divided once by the count `n` (`divCount`), or, where that sum overflows while every
difference is finite, the sum of `d * (d / n)`. Both sums are `reduceSum`'s. -/
@[never_extract, extern "torchlean_cuda_buffer_mse_mean"]
opaque mseMean (d : @& Buffer) (n : UInt64) : Buffer

/-- The slope `2 d / n` of `TorchLean.Tensor.meanSquaredErrorBackward` at each difference `d`: a
finite `d + d` divided once by the count `n` (`divCount`), and otherwise `d / n` doubled, which is
`2 d / n` rounded once at every count `divCount` accepts. -/
@[never_extract, extern "torchlean_cuda_buffer_mse_slope"]
opaque mseSlope (d : @& Buffer) (n : UInt64) : Buffer

/-- `TorchLean.Huber.term` at each prediction `p` and target `t` with the threshold `delta` rounded
to the dtype, every operation in the buffers' dtype and in the rule's order. -/
@[never_extract, extern "torchlean_cuda_buffer_huber_terms"]
opaque huberTerms (p t : @& Buffer) (delta : Float) : Buffer

/-- The slope of `TorchLean.Tensor.huberLossBackward` at each difference `d` before the mean's
division: `d` where `|d| < delta`, else `delta`, `-delta` or `+0` by the sign of `d`, and `+0` at a
NaN. -/
@[never_extract, extern "torchlean_cuda_buffer_huber_slope"]
opaque huberSlope (d : @& Buffer) (delta : Float) : Buffer

/-- Combine a running mean with one sample weighted by `weight`, such as `1 / n` for the `n`-th
sample.

The weight must remain finite and in `(0, 1]` in the buffer dtype. Same-sign finite values use
`mean + (sample - mean) * weight`, and opposite signs use weighted terms. The result is bounded by
the two finite operands, avoiding overflow from either a raw sum or accumulated rounding.
Nonfinite inputs retain the weighted arithmetic's NaN/infinity propagation. Both buffers share one
native dtype and length. The primitive has no configured-word arithmetic.
-/
@[never_extract, extern "torchlean_cuda_buffer_mean_update"]
opaque meanUpdate (mean sample : @& Buffer) (weight : Float) : Buffer

end Buffer

end LibTorch
end TorchLean
