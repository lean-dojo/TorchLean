/-!
# Runtime Initialization

Runtime initializers and shape-indexed initialization plans for executable modules. Applying a
plan fills parameter storage with host tensors on CPU and with device buffers on CUDA. For a seeded
scheme, a host tensor holds the parameter cast of each `TorchLean.Init.sampleAt` sample and a CUDA
buffer holds each sample rounded once to nearest in its dtype, which for `Float32` and `Float`
parameters is the host value.
-/

@[expose] public section

open FloatLib.Floats (ExecFloat)
open FloatLib.Floats.Formats.BinaryInterchange (Model FloatFormat)
open TorchLean.Shape (size)


namespace TorchLean

open TorchLean.Tensor

/-! ## Runtime Float Initializers -/

namespace Init

/--
Runtime initializer for a Float parameter.

The usual `ObjectiveDef.initState` path stores initializers as typed Lean tensors. That is the
right representation when the initial value itself is part of the Lean object being inspected.
A large Float run is better served by runtime storage allocated from a compact initialization
scheme. On CUDA the host tensor is then synchronized only when parameters are read back.

The design mirrors the storage-first APIs used by mainstream runtimes:

- PyTorch exposes in-place initializers such as `torch.nn.init.uniform_`,
  `torch.nn.init.xavier_uniform_`, and `torch.nn.init.kaiming_uniform_` for already-allocated
  tensors: `https://pytorch.org/docs/stable/nn.init.html`.
- PyTorch's meta-device / `to_empty` path separates "module structure exists" from "real storage is
  materialized", after which users initialize the parameters themselves:
  `https://docs.pytorch.org/docs/main/meta.html`.

TorchLean keeps the semantic parameter type (`Tensor Float s`) available, and this runtime path
lets CPU and CUDA execution fill real storage from the initializer.
-/
inductive Source where
  /-- Flat index `i` of the seeded scheme `sch` receives the `Float`
  `TorchLean.Init.sampleAt sch seed i` that `TorchLean.Init.tensor (α := Float) sch seed` stores
  there, converted by the parameter cast on the host and rounded once to the dtype in a CUDA
  buffer. PyTorch analogues: `torch.nn.init.zeros_`, `ones_`, `uniform_`, `normal_`,
  `xavier_uniform_`, `kaiming_uniform_`. -/
  | scheme (sch : Init.Scheme) (seed : Nat := 0)
  /-- Exact row-major payload. Used for imported checkpoints or generated tensors. -/
  | flat (values : FloatArray)

/-- Validate one runtime initializer before it allocates or mutates parameter storage. -/
def Source.validate (expectedSize : Nat) : Source → Except String Unit
  | .scheme sch _ => sch.validate
  | .flat values =>
      if values.size = expectedSize then
        pure ()
      else
        throw s!"torch.runtimeInit: flat initializer length mismatch \
          (expected {expectedSize}, got {values.size})"

/-- One runtime initializer for each parameter shape, in order. A plan selects how the Float
runtime fills the parameter tensors on CPU or CUDA, and proofs concern only the tensors. -/
abbrev Plan : List Shape → Type := Pack fun _ : Shape => Source

namespace Plan

/-- Validate every initializer against its parameter shape before applying the plan. -/
def validate : {ss : List Shape} → Plan ss → Except String Unit
  | .nil, .nil => pure ()
  | .cons shape shapes, .cons init rest => do
      init.validate (Shape.size shape)
      validate (ss := shapes) rest

end Plan

/-- Host `Float` generated by a `Source` at a row-major flat index, before conversion to the
parameter type. A scheme samples through `TorchLean.Init.sampleAt`, the values that
`TorchLean.Init.tensor (α := Float)` stores. A flat payload fails, without a panic, at every index
`idx ≥ values.size`. -/
def sampleFloatAt : Source → Nat → Except String Float
  | .scheme sch seed, idx => .ok (Init.sampleAt sch seed idx)
  | .flat values, idx =>
      match values[idx]? with
      | some value => .ok value
      | none =>
          .error s!"torch.runtimeInit: flat initializer index {idx} is outside its \
            {values.size} values"

/--
Materialize an initializer as a host `FloatArray` of `n` values, once `Source.validate n` accepts
it: the payload of a flat initializer, or the `sampleFloatAt` values of a scheme.

CPU execution uses this path, and `cudaBufferOf` uploads its result for every initializer other
than `zeros` and `ones`. A flat payload must hold `n` values, and any other size throws.
-/
def floatArrayOf (n : Nat) (init : Source) : IO FloatArray := do
  IO.ofExcept (init.validate n)
  match init with
  | .flat values => pure values
  | _ =>
      let mut out : Array Float := Array.mkEmpty n
      for i in [0:n] do
        let value ← IO.ofExcept (sampleFloatAt init i)
        out := out.push value
      pure (FloatArray.mk out)

/--
Allocate a CUDA buffer of `n` elements for a `Source`.

`zeros` and `ones` are filled on the device. Any other initializer uploads `floatArrayOf n init`,
so each element is that host sample rounded once to `dtype`.
-/
def cudaBufferOf (n : Nat) (init : Source)
    (dtype : LibTorch.Dtype := .float32) :
    IO LibTorch.Buffer := do
  let some n32 := Bytes.toUInt32? n
    | throw <| IO.userError
        s!"torch.runtimeInit: tensor too large for CUDA buffer API ({n} elements)"
  match init with
  | .scheme .zeros _ => LibTorch.Buffer.zerosIO n32 dtype
  | .scheme .ones _ => LibTorch.Buffer.fullIO n32 1.0 dtype
  -- Sampling on the device would round intermediates in `dtype` and call the device's `log` and
  -- `cos`, so the host samples are uploaded and each is rounded once.
  | _ => LibTorch.Buffer.ofFloatArrayIO (← floatArrayOf n init) dtype

/-- Materialize a runtime initializer as a normal host tensor. Used for CPU execution. -/
def hostTensorOf {α : Type} [Storage α]
    (cast : Float → α) {s : Shape} (init : Source) :
    IO (Tensor α s) := do
  let n := Shape.size s
  let values ← floatArrayOf n init
  let some tensor := (Tensor.from values).reshape? s
    | throw <| IO.userError
        s!"torch.runtimeInit: initializer length mismatch (expected {n}, got {values.size})"
  pure <| Tensor.map cast tensor

/-- Apply a plan after the public entrypoint has validated every initializer. -/
def applyPlanUnchecked {α : Type} [Storage α] [TensorTransfer α]
    (cast : Float → α) (options : Session.Config) :
    {ss : List Shape} → ParamList α ss → Plan ss → IO Unit
  | .nil, .nil, .nil => pure ()
  | .cons s ss, .cons p ps, .cons init rest => do
      if options.usesCUDA then
        let dtype ← TensorTransfer.dtype (α := α)
        let buf ← cudaBufferOf (Shape.size s) init dtype
        Param.setCUDAValue (α := α) (sh := s) p
          { s := s, buf := buf }
      else
        let t ← hostTensorOf cast (s := s) init
        Param.setHostValue (α := α) (sh := s) p t
      applyPlanUnchecked (α := α) cast (options := options) (ss := ss) ps rest

/--
Apply a shape-indexed initialization plan to an already-created parameter list.

The shape list appears on both sides of the type:

```lean
TorchLean.ParamList α ss → Init.Plan ss → IO Unit
```

The complete plan is validated before any parameter is mutated, so an invalid later initializer
cannot leave the module partially initialized.
-/
def applyPlan {α : Type} [Storage α] [TensorTransfer α]
    (cast : Float → α) (options : Session.Config) {ss : List Shape}
    (parameters : ParamList α ss) (plan : Plan ss) : IO Unit := do
  IO.ofExcept plan.validate
  applyPlanUnchecked (α := α) cast options parameters plan

end Init

/-- Check a model's static contract in order: one `requiresGrad` flag per state shape (the error
names `kind`), the configuration verdict `config`, and `Init.Plan.validate` on `plan` when it
is given. The first failing check's error is returned. -/
def validateStatic (kind : String) {stateShapes : List Shape} (requiresGrad : Array Bool)
    (config : Except String Unit) (plan : Option (Init.Plan stateShapes)) :
    Except String Unit := do
  unless requiresGrad.size = stateShapes.length do
    throw s!"{kind}: expected {stateShapes.length} requiresGrad flags, got {requiresGrad.size}"
  config
  match plan with
  | some plan => plan.validate
  | none => pure ()

/-- `validateStatic` succeeds exactly when there is one `requiresGrad` flag per state shape,
`config` succeeds and `plan`, when given, validates. -/
theorem validateStatic_eq_ok {kind : String} {stateShapes : List Shape} {requiresGrad : Array Bool}
    {config : Except String Unit} {plan : Option (Init.Plan stateShapes)} :
    validateStatic kind requiresGrad config plan = .ok () ↔
      requiresGrad.size = stateShapes.length ∧ config = .ok () ∧
        ∀ p, plan = some p → p.validate = .ok () := by
  unfold validateStatic
  by_cases h : requiresGrad.size = stateShapes.length <;>
    rcases config with e | ⟨⟩ <;> rcases plan with _ | p <;>
    simp [h, bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw]

end TorchLean
