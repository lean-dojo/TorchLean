# Python caches and artifacts
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
python/*.egg-info/
python/build/

# PyTorch checkpoints
*.pt

# Verification experiment outputs. Small checked-in JSON artifacts live next to examples, but new
# generated artifacts should go into these ignored directories or `_external/`.
TorchLeanExamples/Verification/**/generated/
TorchLeanExamples/Verification/**/outputs/
home_page/blueprint/print/*.nfs*

# LaTeX build artifacts (paper/blueprint)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.paux
*.synctex.gz
*.toc
missfont.log

# Verso output (generated HTML/book assets)
/_out/
**/_out/
verso_manual/.verso/
verso_manual/.lake/

# Local experiment repos / scratchpads (not part of the public TorchLean library)
/disabled
testingoblass/
pdf/
plots/

# Local tooling directories. Ignoring a path does not untrack files that git already tracks.
tools/
# `tools/` above ignores scratch tooling directories. This Jekyll route is site content.
!home_page/tools/
!home_page/tools/index.md

# Jekyll / GitHub Pages site build artifacts
home_page/_site/
home_page/.jekyll-cache/
home_page/.sass-cache/
home_page/.jekyll-metadata
home_page/docs/

# Written by `scripts/docs/build_site.sh graphs` from the Lean import graph.
home_page/graphs/dependency-audit.json
home_page/importgraph/index.html

# Bundler installs (avoid committing Ruby gems)
home_page/vendor/
home_page/.bundle/
.bundle/
vendor/bundle/

# Local installers / large downloads
Miniconda3-*.sh

# Blueprint build outputs generated by Verso Blueprint.
# Sources live in `home_page/blueprint/TorchLeanBlueprint`; CI rebuilds and deploys the guide.
home_page/blueprint/print/
home_page/blueprint/web/
# Loose output from invoking the guide generator in the package directory.
# Keep Lean sources, package configuration, and authored Guide/Assets visible.
home_page/blueprint/-verso-data/
home_page/blueprint/-verso-search/
home_page/blueprint/-verso-docs.json
home_page/blueprint/**/*.html
!home_page/blueprint/TorchLeanBlueprint/**/*.html
home_page/blueprint/book.css
home_page/blueprint/verso-vars.css
home_page/blueprint/toc-resize.js
home_page/blueprint/torchlean-guide-polish.js
home_page/blueprint/xref.json
