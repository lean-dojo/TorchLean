module

public import Mathlib.Topology.ContinuousMap.StoneWeierstrass
public import TorchLean.Tensor.Euclidean

/-!
# Stone–Weierstrass Approximation for Tensor Inputs

On any compact set $K\subseteq\mathbb{R}^n$, the subalgebra of continuous functions generated by
the coordinate projections is dense in $C(K,\mathbb{R})$. Equivalently, every continuous function on
a compact set is a uniform limit of polynomial expressions in the coordinates (Stone–Weierstrass).

The statement here is for TorchLean's rank-one tensors `Tensor ℝ [n]` with the Euclidean metric
topology from `TorchLean.Tensor.Euclidean`, and this module installs no topology of its own.
The coordinate projections are read through the equivalence `Tensor.vectorEquiv` with `Fin n → ℝ`,
which is continuous by `Tensor.continuous_vectorEquiv`.

Networks enter in `UniversalApproximation`. It combines
`exists_coordSubalg_near` with a ReLU approximation of every coordinate polynomial to
prove `relu_compact`, the 2-layer ReLU universal approximation theorem on
compact sets in the line of Cybenko, Hornik, Leshno et al. and Pinkus.
-/

@[expose] public section

namespace TorchLean.UniversalApproximation

open TorchLean.Tensor

open ContinuousMap

variable {n : Nat} (K : Set (Tensor ℝ [n]))

/-- Coordinate projection as a continuous map $K\to\mathbb{R}$. -/
noncomputable def coord (i : Fin n) : C(K, ℝ) :=
  ⟨fun x => ((Tensor.vectorEquiv (α := ℝ) n).toFun x.1) i,
    (continuous_apply i).comp
      ((Tensor.continuous_vectorEquiv n).comp continuous_subtype_val)⟩

/-- The subalgebra of $C(K,\mathbb{R})$ generated by the coordinate projections. -/
noncomputable def coordSubalg : Subalgebra ℝ C(K, ℝ) :=
  Algebra.adjoin ℝ (Set.range (coord (K := K)))

/--
Coordinate functions separate points.

Two distinct points of `K` differ in some coordinate under `Tensor.vectorEquiv`, and that
coordinate projection belongs to `coordSubalg`.
-/
theorem coordSubalg_separatesPoints : (coordSubalg (K := K)).SeparatesPoints := by
  classical
  intro x y hxy
  -- Distinct points of `K` have distinct coordinate vectors, hence differ in some coordinate.
  obtain ⟨i, hi⟩ := Function.ne_iff.mp
    ((Tensor.vectorEquiv (α := ℝ) n).injective.ne (Subtype.val_injective.ne hxy))
  -- The `i`-th coordinate projection, viewed as a plain function `K → ℝ`, separates them.
  refine ⟨(fun z : K => ((Tensor.vectorEquiv (α := ℝ) n).toFun z.1) i), ?_, ?_⟩
  · refine ⟨coord (K := K) i, ?_, rfl⟩
    exact Algebra.subset_adjoin (R := ℝ) (A := C(K, ℝ)) ⟨i, rfl⟩
  · simpa using hi

/--
Stone–Weierstrass for the coordinate-generated subalgebra: on a compact `K` its topological closure
is all of $C(K,\mathbb{R})$.

Mathlib proves this for any point-separating subalgebra, and `coordSubalg_separatesPoints` supplies
the separation.
-/
theorem coordSubalg_closure_eq_top [CompactSpace K] :
    (coordSubalg (K := K)).topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints
    (A := coordSubalg (K := K)) (coordSubalg_separatesPoints (K := K))

/--
On a compact `K`, every continuous $f:K\to\mathbb{R}$ is within $\varepsilon$ of an element of the
coordinate-generated subalgebra in the supremum norm, for each $\varepsilon>0$.

The compact-set ReLU theorem `relu_compact` starts from this form.
-/
theorem exists_coordSubalg_near
    [CompactSpace K] (f : C(K, ℝ)) (ε : ℝ) (hε : 0 < ε) :
    ∃ g : coordSubalg (K := K), ‖(g : C(K, ℝ)) - f‖ < ε :=
  ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints
    (A := coordSubalg (K := K))
    (w := coordSubalg_separatesPoints (K := K))
    (f := f) (ε := ε) (pos := hε)

end TorchLean.UniversalApproximation
